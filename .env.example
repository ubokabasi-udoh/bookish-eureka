# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.
# Legend:  [PUBLIC] sent to the browser   [SERVER] server-only   [SECRET] server-only AND sensitive
# ─────────────────────────────────────────────────────────────

# Which adapters to use: "live" (Supabase + Google + Mailgun) or "memory" (in-process fakes for tests/demo).
# [SERVER]
INTEGRATIONS_DRIVER=live

# Public base URL of this app, no trailing slash. Used for OAuth redirects and email links.
# Dev: http://localhost:3000   Prod: https://your-domain.com
# [PUBLIC]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (database + auth session layer) ──
# [PUBLIC] Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# [PUBLIC] anon/publishable key. Safe for the browser ONLY because RLS is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [SECRET] service_role key. Bypasses RLS. Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Mailgun (transactional email) ──
# [SECRET] Private API key
MAILGUN_API_KEY=
# [SERVER] Verified sending domain, e.g. mg.example.com
MAILGUN_DOMAIN=
# [SERVER] From address, e.g. "Shop <orders@mg.example.com>"
MAILGUN_FROM_EMAIL=
# [SERVER] Use https://api.eu.mailgun.net for EU-region domains
MAILGUN_API_BASE_URL=https://api.mailgun.net

# ── Store identity (shown in emails and footer) ──
# [SERVER]
STORE_NAME=Northline
STORE_SUPPORT_EMAIL=support@example.com

# NOTE: Google OAuth Client ID/Secret are NOT app variables. In this architecture they are
# entered in the Supabase dashboard (Authentication → Providers → Google). See README.
